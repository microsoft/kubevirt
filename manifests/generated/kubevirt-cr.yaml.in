---
apiVersion: kubevirt.io/v1
kind: KubeVirt
metadata:
  name: kubevirt
  namespace: {{.Namespace}}
spec:
  certificateRotateStrategy: {}
  configuration:
    developerConfiguration:
      featureGates:{{if .FeatureGates}}
      {{- range .FeatureGates}}
      - {{.}}
      {{- end}}{{else}} []{{end}}
    virtualizationProfile:
      name: qemu-kvm
      virtLauncherConfiguration:
        virtLauncherCapabilities:
        - NET_BIND_SERVICE
        virtLauncherImage: {{.VirtLauncherImage}}
        virtLauncherOverhead: 220Mi
      virtualizationComponentsConfiguration:
        hypervisorDevice: /dev/kvm
        pitPidPrefix: kvm-pit
        vCpuRegex: ^CPU (\d+)/KVM\n$
        vmmDaemonProcess: virtqemud
        vmmProcessExecutables:
        - qemu-system-x86
        - qemu-kvm
        vmmSocketPath: libvirt/virtqemud-sock
  customizeComponents: {}
  imagePullPolicy: {{.ImagePullPolicy}}{{if .InfraReplicas}}
  infra:
    replicas: {{.InfraReplicas}}{{end}}
  workloadUpdateStrategy: {}
